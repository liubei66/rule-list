# --- 本地与系统流量 ---

dip(127.0.0.0/8) -> must_direct
sip(127.0.0.1) && dport(53, 853, 443) -> must_direct

dip(192.168.0.0/16) -> direct
dip(geoip:private) -> direct

pname(
    NetworkManager,
    systemd-resolved,
    dnsmasq,
    lucky,
    adguardhome
) -> must_direct


# --- 协议安全策略 ---

l4proto(udp) && dport(443) -> block

dip(224.0.0.0/4, 'ff00::/8') -> direct

dport(7680) -> direct


# --- 广告高优拦截 ---

domain(geosite:category-ads) -> block

# --- 大陆白名单与本地地理分流 ---

domain(
    geosite:cn,
    geosite:china-list,
    geosite:apple@cn,
    geosite:microsoft@cn
) -> direct

dip(geoip:cn) -> direct


